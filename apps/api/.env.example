# Fastify Server Options
PORT=3001
HOST=0.0.0.0
FRONTEND_URL=http://localhost:3000

# PostgreSQL Connection (Supabase or Local)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/expensio
DATABASE_SSL=false

# Redis (Upstash or Local)
# For Upstash, use rediss://default:PASSWORD@HOST:PORT
REDIS_URL=redis://127.0.0.1:6379

# Supabase Storage & Auth
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_API_KEY=your_meilisearch_api_key_here
